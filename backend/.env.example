PORT=5000

# Use standard mongodb:// URI if mongodb+srv:// fails with querySrv ECONNREFUSED
# (Node.js may use 127.0.0.1 for DNS while system tools use your router DNS).
# Include the database name in the path, e.g. /campusfix
MONGO_URI=mongodb://<username>:<password>@<host1>:27017,<host2>:27017,<host3>:27017/campusfix?ssl=true&replicaSet=<replica-set>&authSource=admin
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRE=7d

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
